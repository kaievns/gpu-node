# Template only — DO NOT commit a populated copy.
# Create the real Secret with:
#
#   kubectl -n gpu-node-system create secret generic gpu-node-controller-secret \
#     --from-literal=agent-token="$(cat /etc/gaming-agent/token)"
#
# (where /etc/gaming-agent/token is the value generated on the gpu-node host).
apiVersion: v1
kind: Secret
metadata:
  name: gpu-node-controller-secret
  namespace: gpu-node-system
type: Opaque
stringData:
  agent-token: "REPLACE_ME"
