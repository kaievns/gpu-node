# Copy to .env (ignored by git) and fill in.
#
# AGENT_TOKEN is the bearer token the controller pod sends to the gaming-agent
# on the host. rehydrate/host/85-gaming-agent writes it to
# /etc/gaming-agent/token; rehydrate/cluster/30-controller writes it to the
# gpu-node-controller-secret Secret. Both checkouts need the same .env.
#
#   openssl rand -hex 32
AGENT_TOKEN=
