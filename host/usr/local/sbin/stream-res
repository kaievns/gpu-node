#!/bin/bash
# Pin the headless stream output mode, overriding the per-client switching
# done by stream-mode. Restarts gamescope + Sunshine (~20 s, Steam session
# included). `auto` unpins. See docs/streaming.md §6.
set -euo pipefail

CONF_DIR=/etc/gamescope-headless
CONF="$CONF_DIR/resolution"
MODE_FILE=/home/gamer/.config/gamescope/modes.cfg
LOG=/home/gamer/.local/state/gamescope-headless.log

usage() {
  cat <<EOF
usage: stream-res <auto|preset|WxH[@R]> [--force] | status
auto:    unpin; automatic per client, idle at stream-mode's default
presets: deck  = 1280x800@90
         1080p = 1920x1080@60
         1440p = 2560x1440@90
         1200p = 1920x1200@90
EOF
  exit 1
}

mode_line() { sudo grep -o "selecting mode .*" "$LOG" 2>/dev/null | tail -1; }

if [ "${1:-}" = status ]; then
  if [ -r "$CONF" ]; then echo "pinned: $(tr '\n' ' ' <"$CONF")"; else echo "pinned: no (automatic per client; last request: $(sudo cat "$MODE_FILE" 2>/dev/null | cut -d: -f2 | tr -d '\n' || true))"; fi
  echo "gamescope: $(systemctl is-active gamescope-headless || true) [$(mode_line || echo n/a)]"
  echo "sunshine:  $(systemctl is-active sunshine || true)"
  exit 0
fi

case "${1:-}" in
  auto)  W=auto H=auto R=auto ;;
  deck)  W=1280 H=800  R=90 ;;
  1080p) W=1920 H=1080 R=60 ;;
  1440p) W=2560 H=1440 R=90 ;;
  1200p) W=1920 H=1200 R=90 ;;
  *x*@*) W=${1%%x*} H=${1#*x}; H=${H%@*}; R=${1##*@} ;;
  *x*)   W=${1%%x*} H=${1#*x} R=60 ;;
  *) usage ;;
esac
if [ "$W" != auto ]; then
  case "$W$H$R" in ''|*[!0-9]*) usage ;; esac
  grep -qx "${W}x${H}" /sys/class/drm/card*-HDMI-A-1/modes || {
    echo "error: ${W}x${H} not offered by the injected EDID (see */modes)"; exit 1; }
fi

if [ "${2:-}" != --force ]; then
  last=$(sudo journalctl -u sunshine -b --no-pager | grep -E "CLIENT (CONNECTED|DISCONNECTED)" | tail -1) || true
  case "$last" in *"CLIENT CONNECTED"*)
    echo "refusing: a client looks connected (--force to override)"
    echo "  $last"
    exit 1 ;;
  esac
fi

write_conf() {
  if [ "$1" = auto ]; then
    sudo rm -f "$CONF"
  else
    sudo mkdir -p "$CONF_DIR"
    printf 'GS_W=%s\nGS_H=%s\nGS_R=%s\n' "$1" "$2" "$3" | sudo tee "$CONF" >/dev/null
  fi
}

restart_stack() {
  sudo systemctl stop sunshine
  sudo systemctl stop gamescope-headless 2>/dev/null || true
  sudo systemctl reset-failed gamescope-headless 2>/dev/null || true
  sudo systemctl start gamescope-headless
}

verify() {
  for _ in $(seq 1 20); do
    sleep 1
    mode_line | grep -q "selecting mode $1x$2@" && return 0
  done
  return 1
}

go_auto() {
  write_conf auto
  restart_stack
  verify '[0-9]*' '[0-9]*' || return 1
  sudo -u gamer /usr/local/bin/stream-mode --default
}

if [ "$W" = auto ]; then
  go_auto || { echo "gamescope did not come up — inspect gamescope-headless"; exit 2; }
  sudo systemctl start sunshine
  echo "ok: automatic; $(mode_line); sunshine $(systemctl is-active sunshine)"
  exit 0
fi

write_conf "$W" "$H" "$R"
restart_stack
if ! verify "$W" "$H"; then
  echo "mode ${W}x${H} did not come up ($(mode_line || echo no mode)) — reverting to automatic"
  go_auto || { echo "REVERT FAILED — inspect gamescope-headless"; exit 2; }
  sudo systemctl start sunshine
  exit 1
fi
sudo systemctl start sunshine
echo "ok: $(mode_line); sunshine $(systemctl is-active sunshine)"
