[Unit]
Description=Kill running Steam game on Sunshine client disconnect (immediate + retry 20s later for race-during-launch)
After=sunshine.service
Wants=sunshine.service

[Service]
User=gamer
Group=gamer
Type=simple
Restart=on-failure
RestartSec=10
ExecStart=/bin/bash -c 'tail -F -n0 /home/gamer/.config/sunshine/sunshine.log 2>/dev/null | while IFS= read -r line; do case "$line" in *"CLIENT DISCONNECTED"*) /usr/local/sbin/kill-running-game.sh; ( sleep 20; /usr/local/sbin/kill-running-game.sh ) & ;; esac; done'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/gamer/.config/sunshine
ReadWritePaths=/var/log/kill-running-game.log
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
