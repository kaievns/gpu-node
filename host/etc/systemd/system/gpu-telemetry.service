[Unit]
Description=1Hz GPU telemetry capture for Xid forensics
Documentation=man:nvidia-smi(1)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/gpu-telemetry.sh
StandardOutput=append:/var/log/gpu-telemetry.log
StandardError=append:/var/log/gpu-telemetry.log
Restart=on-failure
RestartSec=5

# Low priority — don't compete with workloads
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
