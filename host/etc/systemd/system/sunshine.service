[Unit]
Description=Sunshine (Moonlight host) - KMS capture of gamescope-headless
After=gamescope-headless.service network-online.target
BindsTo=gamescope-headless.service

[Service]
User=gamer
Group=gamer
SupplementaryGroups=input video render
Environment=HOME=/home/gamer
Environment=XDG_RUNTIME_DIR=/run/user/1100
Environment=PULSE_SERVER=unix:/run/user/1100/pulse/native
ExecStart=/usr/bin/sunshine
Restart=on-failure
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
